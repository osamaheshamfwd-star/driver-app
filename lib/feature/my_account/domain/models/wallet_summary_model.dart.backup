// ─────────────────────────────────────────────────────────────────────────────
// WalletSummaryModel
//
// Mapped from GET /api/v1/delivery-man/wallet-summary response.
// Field names chosen to mirror ProfileModel where possible so the controller's
// merged-getter pattern stays trivial to maintain.
//
// Fallback strategy: if any field is absent from the API response (null),
// MyAccountController.merged getters fall back to ProfileModel equivalents.
// ─────────────────────────────────────────────────────────────────────────────

class WalletSummaryModel {
  double? payableBalance;       // "المبلغ المطلوب سداده" — banner amount
  double? withDrawableBalance;  // "الفلوس اللي ليك"     — card 1
  double? cashInHands;          // "الفلوس اللي عليك"    — card 2
  bool?   adjustable;           // controls "adjust_payments" button visibility
  bool?   showPayNowButton;     // controls "pay_now" button enabled state
  bool?   overFlowWarning;      // bottom warning bar (soft)
  bool?   overFlowBlockWarning; // bottom warning bar (hard block)

  WalletSummaryModel({
    this.payableBalance,
    this.withDrawableBalance,
    this.cashInHands,
    this.adjustable,
    this.showPayNowButton,
    this.overFlowWarning,
    this.overFlowBlockWarning,
  });

  factory WalletSummaryModel.fromJson(Map<String, dynamic> json) {
    return WalletSummaryModel(
      // Accept both the documented key and the ProfileModel key name as fallback.
      payableBalance: (json['payable_balance'] ?? json['Payable_Balance'])?.toDouble(),
      withDrawableBalance: (json['withdraw_able_balance'] ?? json['withdrawable_balance'])?.toDouble(),
      cashInHands: (json['cash_in_hands'] ?? json['cash_in_hand'])?.toDouble(),
      adjustable: json['adjust_able'] as bool?,
      showPayNowButton: json['show_pay_now_button'] as bool?,
      overFlowWarning: json['over_flow_warning'] as bool?,
      overFlowBlockWarning: json['over_flow_block_warning'] as bool?,
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'payable_balance': payableBalance,
      'withdraw_able_balance': withDrawableBalance,
      'cash_in_hands': cashInHands,
      'adjust_able': adjustable,
      'show_pay_now_button': showPayNowButton,
      'over_flow_warning': overFlowWarning,
      'over_flow_block_warning': overFlowBlockWarning,
    };
  }
}
